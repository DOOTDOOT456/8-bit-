{
  "name": "8bit-minecraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port $PORT",
    "build": "vite build",
    "build:standalone": "vite build && node scripts/copy-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0 --port $PORT",
    "test": "vitest run",
    "server": "cd server && npm start",
    "dev:all": "npm run server & npm run dev",
    "deploy:gh-pages": "npm run build && gh-pages -d dist -e index.html"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9",
    "gh-pages": "^6.1.1"
  }
}
