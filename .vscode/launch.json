{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Game (Frontend)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "console": "integratedTerminal"
    },
    {
      "name": "Launch Netplay Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.mjs",
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8787"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run Full Game (Frontend + Server)",
      "configurations": ["Launch Netplay Server", "Launch Game (Frontend)"]
    }
  ]
}
